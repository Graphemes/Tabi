# Postgres. Matches docker-compose.yml (`docker compose up -d`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tabi?schema=public"

# Token signing secrets. Required: the backend refuses to start without them.
# Generate each with: openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Optional, defaults to 3001.
# PORT=3001
