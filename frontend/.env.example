NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:3001

# Map tiles + place search. Free key from https://cloud.maptiler.com/account/keys/
# Browser-visible — restrict it to your origins in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=

# Road routing (visit order + the route line). Optional: defaults to the public OSRM
# demo server, which is rate-limited and not for production — self-host OSRM for that.
# NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org
